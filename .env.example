# SecureFlow AI configuration
# Copy to .env (server reads the process environment; no dotenv dependency is bundled).

# --- core ---
PORT=4000
NODE_ENV=development
# Absolute or relative path for the SQLite database and evidence files.
# SF_DATA_DIR=./backend/data
# SF_DB_PATH=./backend/data/secureflow.db
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For.
SF_TRUST_PROXY=false

# --- first run ---
# Demo mode seeds synthetic data and known demo accounts.
# Default: on outside production, off in production.
# SF_DEMO_MODE=false
# Only for a throwaway production demo host. Never on real data.
# SF_ALLOW_INSECURE_DEMO=false
# Required on an empty production database when demo mode is off.
# SF_BOOTSTRAP_EMAIL=you@your-domain.example
# SF_BOOTSTRAP_PASSWORD=use-a-long-unique-passphrase
# SF_BOOTSTRAP_ORG=Your Organization
# SF_BOOTSTRAP_NAME=Your Name

# --- optional reputation providers (no call is made unless a key is present) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- optional external integrations (status is shown as unconfigured until set) ---
WAZUH_API_URL=
WAZUH_API_TOKEN=
SYSMON_COLLECTOR_URL=
SURICATA_EVE_PATH=
ZEEK_LOG_PATH=
CLAMAV_HOST=
YARA_RULES_PATH=

# --- MiroFish (AGPL-3.0) runs as a separate service on Python 3.11-3.12 ---
# MIROFISH_BASE_URL=http://127.0.0.1:5001
# MIROFISH_API_KEY=

# --- API Anything is a development-time MCP tool, never a runtime dependency ---
API_ANYTHING_ENABLED=false

# --- website protection ---
# Default: on outside production, off in production until the launch gates in
# docs/website/STATUS.md are accepted by the owner.
# SF_WEBSITE_PROTECTION=false
# Allows .test hostnames in development and tests. Refused in production.
SF_ALLOW_TEST_HOSTNAMES=false
# Days a failing daily re-verification may last before the website lapses.
SF_WEBSITE_VERIFICATION_GRACE_DAYS=14
# Optional comma separated DNS servers used for TXT verification.
SF_DNS_RESOLVERS=
# Comma separated domains that belong to the platform and cannot be registered.
SF_PLATFORM_DOMAINS=
# Heartbeat period the SDK is expected to use, and the hourly notification cap.
SF_SDK_HEARTBEAT_SECONDS=900
SF_NOTIFICATION_HOURLY_CAP=60
