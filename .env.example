# SecureFlow AI configuration
# Copy to .env (server reads the process environment; no dotenv dependency is bundled).

# --- core ---
PORT=4000
NODE_ENV=development
# Absolute or relative path for the SQLite database and evidence files.
# SF_DATA_DIR=./backend/data
# SF_DB_PATH=./backend/data/secureflow.db
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For.
SF_TRUST_PROXY=false

# --- first run ---
# Demo mode seeds synthetic data and known demo accounts.
# Default: on outside production, off in production.
# SF_DEMO_MODE=false
# Only for a throwaway production demo host. Never on real data.
# SF_ALLOW_INSECURE_DEMO=false
# Required on an empty production database when demo mode is off.
# SF_BOOTSTRAP_EMAIL=you@your-domain.example
# SF_BOOTSTRAP_PASSWORD=use-a-long-unique-passphrase
# SF_BOOTSTRAP_ORG=Your Organization
# SF_BOOTSTRAP_NAME=Your Name

# --- email verification (Phase 1.3) ---
# Server side only. Never expose these in frontend code or a public bundle.
# Without both RESEND_API_KEY and EMAIL_FROM, new accounts stay unverified and
# each registration is audited as auth.email_verification_failed.
RESEND_API_KEY=
# Must be a sender verified in Resend. onboarding@resend.dev only delivers to the
# Resend account owner's address.
EMAIL_FROM=
# Public origin used to build the verification link. Must be https in production.
APP_BASE_URL=http://localhost:4000

# --- optional reputation providers (no call is made unless a key is present) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- optional external integrations (status is shown as unconfigured until set) ---
WAZUH_API_URL=
# Read only manager API user. Alternatively set WAZUH_API_TOKEN.
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_API_TOKEN=
# Trust the manager certificate with NODE_EXTRA_CA_CERTS instead of disabling TLS.
# NODE_EXTRA_CA_CERTS=C:\certs\wazuh-ca.pem
SYSMON_COLLECTOR_URL=
SURICATA_EVE_PATH=
ZEEK_LOG_PATH=
CLAMAV_HOST=
YARA_RULES_PATH=

# --- MiroFish (AGPL-3.0) runs as a separate service on Python 3.11-3.12 ---
# MIROFISH_BASE_URL=http://127.0.0.1:5001
# MIROFISH_API_KEY=

# --- API Anything is a development-time MCP tool, never a runtime dependency ---
API_ANYTHING_ENABLED=false

# --- website protection ---
# Default: on outside production, off in production until the launch gates in
# docs/website/STATUS.md are accepted by the owner.
# SF_WEBSITE_PROTECTION=false
# Allows .test hostnames in development and tests. Refused in production.
SF_ALLOW_TEST_HOSTNAMES=false
# Days a failing daily re-verification may last before the website lapses.
SF_WEBSITE_VERIFICATION_GRACE_DAYS=14
# Optional comma separated DNS servers used for TXT verification.
SF_DNS_RESOLVERS=
# Comma separated domains that belong to the platform and cannot be registered.
SF_PLATFORM_DOMAINS=
# Heartbeat period the SDK is expected to use, and the hourly notification cap.
SF_SDK_HEARTBEAT_SECONDS=900
SF_NOTIFICATION_HOURLY_CAP=60
# --- TriShield: perimeter and firewall ---
# Master switch. false unmounts the API and hides the page.
TRISHIELD_ENABLED=true
# Per layer switches. A disabled layer is not mounted in the API either.
TRISHIELD_NETWORK_ENABLED=true
TRISHIELD_ENDPOINT_ENABLED=true
TRISHIELD_IP_SHIELD_ENABLED=true
TRISHIELD_RESPONSE_ENABLED=true
# No firewall command is issued while this is false. An action still needs an
# administrator, an approval, and a successful provider verification.
TRISHIELD_FIREWALL_APPLY=false
# Second gate for the deterministic automatic-block policy. Both flags are needed.
TRISHIELD_AUTO_APPLY=false
# Hard ceiling on active rules per organization.
TRISHIELD_MAX_RULES=500
# Path to the nft binary on a Linux host. The table is always "inet secureflow".
SF_NFT_BIN=nft
# Optional Cloudflare account firewall. Server-side token only.
SF_CLOUDFLARE_API_TOKEN=
SF_CLOUDFLARE_ACCOUNT_ID=

# --- TriShield: IP Shield ---
# Keyed fingerprint for pseudonymous correlation. A JSON object of version to
# base64 encoded 32 byte secret: {"v2":"<base64>","v1":"<base64>"}
SF_IP_HMAC_KEYS=
# Single key fallback, used only when SF_IP_HMAC_KEYS is empty.
SF_IP_HMAC_KEY=
# AES-256-GCM vault keys for the original address. Same JSON object format.
SF_IP_VAULT_KEYS=
SF_IP_VAULT_KEY=
# Stored with every fingerprint and vault record so rotation is auditable.
SF_IP_KEY_VERSION=v1
# Optional HTTPS endpoint used to discover the public egress address. The answer
# is recorded as an unverified origin, never as the verified origin.
SF_PUBLIC_IP_URL=
# Comma separated interfaces whose addresses must never be firewalled.
SF_MANAGEMENT_INTERFACES=

# --- TriShield: collectors ---
# Collector tokens are created in the TriShield page and stored hashed.
# Suricata posts EVE JSON to /api/trishield/ingest/suricata with that token.
