{
  "name": "secureflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "SecureFlow AI - intelligent cybersecurity operations platform",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "node backend/src/index.js",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test",
    "test:sdk": "npm --prefix packages/sdk-node test",
    "test:all": "npm test && npm run test:sdk",
    "scan:secrets": "node scripts/check-secrets.mjs",
    "typecheck": "npm --prefix frontend run typecheck"
  }
}
